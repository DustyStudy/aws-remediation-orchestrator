# Copy to terraform.tfvars and adjust before applying.
#
# match_field/match_value are illustrative starting points, not guaranteed
# ASFF strings - Security Hub's exact Types/GeneratorId values for a given
# finding depend on which product (GuardDuty, Config, a specific control)
# produced it. Before relying on a rule, confirm the real value with:
#
#   aws securityhub get-findings --max-results 5 \
#     --filters '{"GeneratorId":[{"Value":"<substring>","Comparison":"CONTAINS"}]}'
#
# See docs/POLICY_REGISTRY.md for the full schema and more examples,
# including how to point action_document at a playbook owned by another
# deployment via external_ssm_document_arns.

notification_email = "security-team@example.com"

policy_registry_seed = {
  default = {
    match_field  = "type_prefix"
    match_value  = ""
    mode         = "dry_run"
    description  = "Fallback when nothing more specific matches. Dry-run so an unrecognized finding is logged, never silently auto-remediated."
  }

  s3-public-access = {
    match_field           = "type_prefix"
    match_value           = "Software and Configuration Checks/S3"
    mode                  = "auto"
    action_document       = "remediation-orchestrator-S3PublicAccessRemediation"
    action_document_owner = "self"
    nist_controls         = ["AC-3", "SC-28"]
    max_actions_per_hour  = 20
    severity_threshold    = "MEDIUM"
    description           = "Re-applies S3 Block Public Access. Safe to run automatically - idempotent, can only reduce exposure."
  }

  # GuardDuty UnauthorizedAccess:IAMUser/MaliciousIPCaller (and .Custom).
  # GuardDuty says "IAMUser" for any principal, so the playbook refuses
  # findings about a role; RevokeRoleSessions handles those.
  guardduty-compromised-credentials = {
    match_field           = "type_prefix"
    match_value           = "TTPs/UnauthorizedAccess:IAMUser-MaliciousIPCaller"
    mode                  = "approval_required"
    action_document       = "remediation-orchestrator-DisableCompromisedCredentials"
    action_document_owner = "self"
    nist_controls         = ["AC-2", "IR-4"]
    max_actions_per_hour  = 5
    severity_threshold    = "HIGH"
    description           = "Deactivates an IAM user's access keys. Disruptive if the finding is a false positive, so a human confirms first."
  }

  # Security Hub controls EC2.13 (port 22) and EC2.14 (port 3389).
  open-ssh = {
    match_field           = "generator_id"
    match_value           = "security-control/EC2.13"
    mode                  = "auto"
    action_document       = "remediation-orchestrator-RevokeOpenSshRdpIngress"
    action_document_owner = "self"
    nist_controls         = ["SC-7", "AC-4"]
    max_actions_per_hour  = 20
    severity_threshold    = "MEDIUM"
    description           = "Revokes internet-wide SSH ingress. Safe to run automatically - only removes 0.0.0.0/0 and ::/0 rules on open_ingress_revoke_ports."
  }

  open-rdp = {
    match_field           = "generator_id"
    match_value           = "security-control/EC2.14"
    mode                  = "auto"
    action_document       = "remediation-orchestrator-RevokeOpenSshRdpIngress"
    action_document_owner = "self"
    nist_controls         = ["SC-7", "AC-4"]
    max_actions_per_hour  = 20
    severity_threshold    = "MEDIUM"
    description           = "Revokes internet-wide RDP ingress. Same playbook as open-ssh."
  }

  # Security Hub control EC2.19 (high-risk ports, including 3306, 5432 and
  # 1433, open to the internet). The playbook closes only the ports in
  # open_ingress_revoke_ports. EC2.19 also lists ports such as 25 and 8080
  # that can serve the public on purpose; those are left alone.
  open-high-risk-ports = {
    match_field           = "generator_id"
    match_value           = "security-control/EC2.19"
    mode                  = "auto"
    action_document       = "remediation-orchestrator-RevokeOpenSshRdpIngress"
    action_document_owner = "self"
    nist_controls         = ["SC-7", "AC-4", "CM-7"]
    max_actions_per_hour  = 20
    severity_threshold    = "MEDIUM"
    description           = "Revokes internet-wide database and remote-administration ingress. Same playbook as open-ssh."
  }

  # Security Hub control EC2.18 (any port other than the authorized ones,
  # 80 and 443 by default, open to the internet). EC2.19 has a fixed port
  # list that leaves out LiteLLM (4000) and Ollama (11434), so this is the
  # control that reports them. The playbook still closes only the ports in
  # open_ingress_revoke_ports and leaves every other rule alone.
  open-unauthorized-ports = {
    match_field           = "generator_id"
    match_value           = "security-control/EC2.18"
    mode                  = "auto"
    action_document       = "remediation-orchestrator-RevokeOpenSshRdpIngress"
    action_document_owner = "self"
    nist_controls         = ["SC-7", "AC-4", "CM-7"]
    max_actions_per_hour  = 20
    severity_threshold    = "MEDIUM"
    description           = "Revokes internet-wide ingress to self-hosted AI server ports and the other ports in open_ingress_revoke_ports. Same playbook as open-ssh."
  }

  # Security Hub control IAM.3 (keys not rotated in 90 days).
  stale-access-keys = {
    match_field           = "generator_id"
    match_value           = "security-control/IAM.3"
    mode                  = "approval_required"
    action_document       = "remediation-orchestrator-DeactivateStaleAccessKeys"
    action_document_owner = "self"
    nist_controls         = ["IA-5(1)", "AC-2(3)"]
    max_actions_per_hour  = 10
    severity_threshold    = "MEDIUM"
    description           = "Deactivates only the user's stale keys. An old key can still be in use, so a human confirms first."
  }

  guardduty-compromised-instance = {
    match_field           = "type_prefix"
    match_value           = "TTPs/Command and Control"
    mode                  = "approval_required"
    action_document       = "remediation-orchestrator-IsolateCompromisedInstance"
    action_document_owner = "self"
    nist_controls         = ["IR-4", "SC-7"]
    max_actions_per_hour  = 5
    severity_threshold    = "HIGH"
    description           = "Snapshots and network-isolates the instance. An outage if the finding is wrong, so a human confirms first."
  }

  # GuardDuty UnauthorizedAccess:IAMUser/InstanceCredentialExfiltration.InsideAWS
  # and .OutsideAWS: instance-role credentials used from somewhere else.
  guardduty-role-credential-exfiltration = {
    match_field           = "type_prefix"
    match_value           = "Effects/Data Exfiltration/UnauthorizedAccess:IAMUser-InstanceCredentialExfiltration"
    mode                  = "approval_required"
    action_document       = "remediation-orchestrator-RevokeRoleSessions"
    action_document_owner = "self"
    nist_controls         = ["AC-2", "IR-4", "IA-5"]
    max_actions_per_hour  = 5
    severity_threshold    = "HIGH"
    description           = "Denies every session of the role issued before now. Workloads on the role fail until they refresh, so a human confirms first."
  }
}

# Optional: import Wiz findings through a webhook endpoint. They arrive
# with generator_id "wiz/<title>". See terraform/modules/wiz-finding-bridge.
# enable_wiz_finding_bridge = true
